    <style name="Widget.NexaChat.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/colorSurfaceContainerHigh</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeWidth">@dimen/control_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/focus_stroke_width</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.NexaChat.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/colorPrimary</item>
        <item name="tabSelectedTextColor">@color/colorPrimary</item>
        <item name="tabTextColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.NexaChat.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">true</item>
        <item name="chipCornerRadius">@dimen/corner_sm</item>
        <item name="chipBackgroundColor">@color/nexa_filter_chip_bg</item>
        <item name="android:textColor">@color/nexa_filter_chip_text</item>
        <item name="checkedIconTint">@color/nexa_filter_chip_text</item>
        <item name="chipStrokeColor">@color/stitch_chip_stroke_color</item>
        <item name="chipStrokeWidth">@dimen/control_stroke_width</item>
        <item name="chipMinHeight">@dimen/chip_min_height</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="chipMinTouchTargetSize">@dimen/min_touch_target</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">@color/nexa_button_ripple</item>
    </style>

    <style name="Widget.NexaChat.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconTint">@null</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_inset</item>
        <item name="backgroundTint">@color/colorSurfaceContainerLowest</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/control_stroke_width</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="rippleColor">@color/nexa_button_ripple</item>
    </style>

    <style name="Widget.NexaChat.TextInputLayout.Auth" parent="Widget.NexaChat.TextInputLayout">
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- One dialog look: 24dp container, Inter type, square buttons.
         Every MaterialAlertDialogBuilder re-wraps the context in the
         materialAlertDialogTheme overlay, so the button-bar styles must be
         repointed inside the overlay or the Material defaults re-round them. -->
    <style name="MaterialAlertDialog.NexaChat" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.NexaChat.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.HeadlineSmall</item>
    </style>

    <style name="MaterialAlertDialog.NexaChat.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.BodyMedium</item>
    </style>

    <style name="ThemeOverlay.NexaChat.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.NexaChat</item>
        <item name="buttonBarButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog.Flush</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.NexaChat.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.NexaChat.Body.Text</item>
    </style>

    <!-- Date/time pickers wrap the context in their own overlays, which pin
         the Material rounded button styles; repoint every button they own. -->
