    <style name="Widget.NexaChat.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="backgroundTint">@color/nexa_filled_button_bg</item>
        <item name="android:textColor">@color/nexa_filled_button_text</item>
        <item name="rippleColor">@color/nexa_filled_button_ripple</item>
    </style>

    <style name="Widget.NexaChat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
        <item name="strokeWidth">@dimen/control_stroke_width</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/nexa_outlined_button_text</item>
        <item name="rippleColor">@color/nexa_button_ripple</item>
    </style>

    <style name="Widget.NexaChat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="android:textColor">@color/nexa_outlined_button_text</item>
        <item name="rippleColor">@color/nexa_button_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
    </style>

    <style name="Widget.NexaChat.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="rippleColor">@color/nexa_button_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
        <item name="backgroundTint">@color/colorPrimaryContainer</item>
        <item name="android:textColor">@color/colorOnPrimaryContainer</item>
        <item name="iconTint">@color/colorOnPrimaryContainer</item>
    </style>

    <!-- Lets code-built MaterialButtons inherit the tonal look via a wrapped context. -->
    <style name="ThemeOverlay.NexaChat.Button.Tonal" parent="">
        <item name="materialButtonStyle">@style/Widget.NexaChat.Button.Tonal</item>
    </style>

    <style name="Widget.NexaChat.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
    </style>

    <style name="Widget.NexaChat.Button.Text.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="shapeAppearance">@style/ShapeAppearance.NexaChat.Button</item>
    </style>

    <style name="Widget.NexaChat.Button.Text.Dialog.Flush" parent="Widget.Material3.Button.TextButton.Dialog.Flush">
