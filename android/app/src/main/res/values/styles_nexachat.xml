        <item name="materialButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog.Flush</item>
        <item name="buttonBarButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog.Flush</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="materialCalendarStyle">@style/Widget.NexaChat.MaterialCalendar</item>
        <item name="materialCalendarHeaderCancelButton">@style/Widget.NexaChat.MaterialCalendar.HeaderButton</item>
        <item name="materialCalendarHeaderConfirmButton">@style/Widget.NexaChat.MaterialCalendar.HeaderButton</item>
        <item name="materialCalendarYearNavigationButton">@style/Widget.NexaChat.MaterialCalendar.YearNavigationButton</item>
        <item name="materialCalendarMonthNavigationButton">@style/Widget.NexaChat.MaterialCalendar.MonthNavigationButton</item>
