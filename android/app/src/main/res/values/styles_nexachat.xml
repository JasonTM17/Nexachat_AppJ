<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexaChat.Views" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/colorSurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/colorSurfaceContainerHighest</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.NexaChat.Button</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.NexaChat.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.NexaChat.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.NexaChat.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.NexaChat.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.NexaChat.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.NexaChat.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.NexaChat.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.NexaChat.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.NexaChat.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.NexaChat.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.NexaChat.LabelSmall</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.NexaChat.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NexaChat.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.NexaChat.Large</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.NexaChat.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.NexaChat.Button.Text</item>
        <item name="textInputStyle">@style/Widget.NexaChat.TextInputLayout</item>
    </style>

    <style name="Widget.NexaChat.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="backgroundTint">@color/nexa_filled_button_bg</item>
        <item name="android:textColor">@color/nexa_filled_button_text</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NexaChat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="strokeWidth">@dimen/control_stroke_width</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/nexa_outlined_button_text</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NexaChat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="android:textColor">@color/nexa_outlined_button_text</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NexaChat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="boxStrokeWidth">@dimen/control_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/focus_stroke_width</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.NexaChat.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">true</item>
        <item name="chipCornerRadius">@dimen/corner_full</item>
        <item name="chipBackgroundColor">@color/nexa_filter_chip_bg</item>
        <item name="android:textColor">@color/nexa_filter_chip_text</item>
        <item name="checkedIconTint">@color/nexa_filter_chip_text</item>
        <item name="chipStrokeColor">@color/stitch_chip_stroke_color</item>
        <item name="chipStrokeWidth">@dimen/control_stroke_width</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="chipMinTouchTargetSize">@dimen/min_touch_target</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NexaChat.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconTint">@null</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_inset</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/control_stroke_width</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.NexaChat.LabelLarge</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NexaChat.TextInputLayout.Auth" parent="Widget.NexaChat.TextInputLayout">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
