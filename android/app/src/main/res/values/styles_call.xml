<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NexaChat.Call" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorAccent">@color/call_avatar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorBackground">@color/nexa_call_surface</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="colorSurface">@color/nexa_call_surface</item>
        <item name="colorSurfaceContainer">@color/nexa_call_surface_end</item>
        <item name="colorSurfaceContainerHigh">@color/nexa_call_surface_end</item>
        <item name="colorSurfaceContainerHighest">@color/nexa_call_surface_end</item>
        <item name="colorOnSurface">@color/call_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/call_text_secondary</item>
        <item name="colorPrimary">@color/call_avatar_background</item>
        <item name="colorOnPrimary">@color/call_avatar_foreground</item>
        <item name="colorError">@color/call_end_background</item>
        <item name="colorOnError">@color/call_text_primary</item>
        <item name="materialButtonStyle">@style/Widget.NexaChat.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.NexaChat.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.NexaChat.Button.Text</item>
        <item name="materialIconButtonStyle">@style/Widget.NexaChat.Button.Icon</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog.Flush</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NexaChat.Button.Text.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NexaChat.Call.MaterialAlertDialog</item>
        <item name="snackbarButtonStyle">@style/Widget.NexaChat.Button.Text.Snackbar</item>
    </style>

    <style name="Widget.NexaChat.CallControl" parent="Widget.NexaChat.Button.Icon">
        <item name="android:layout_width">@dimen/min_touch_target</item>
        <item name="android:layout_height">@dimen/min_touch_target</item>
        <item name="android:layout_marginHorizontal">@dimen/space_xs</item>
        <item name="android:minWidth">@dimen/min_touch_target</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/call_control_background</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/call_icon_on_control</item>
    </style>

    <!-- The call scene is always dark; dialog actions use a light plum so they stay legible. -->
    <style name="ThemeOverlay.NexaChat.Call.MaterialAlertDialog" parent="ThemeOverlay.NexaChat.MaterialAlertDialog">
        <item name="colorPrimary">@color/call_dialog_action</item>
    </style>
</resources>
