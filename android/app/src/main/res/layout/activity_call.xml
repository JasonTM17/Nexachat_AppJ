<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 120dp Avatar with soft pulse ring -->
        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/call_pulse_ring"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:background="@drawable/bg_call_pulse_ring"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/call_peer_initials"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/call_avatar_foreground"
                android:textSize="36sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Peer Name -->
        <TextView
            android:id="@+id/call_peer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/call_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Call Status -->
        <TextView
            android:id="@+id/call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/call_text_secondary"
            android:textSize="15sp" />

        <!-- Timer -->
        <TextView
            android:id="@+id/call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/call_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- Circular Action Controls (64dp mute, 64dp speaker, 72dp red end) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Mute Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/call_mute"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_control_button"
                    app:backgroundTint="@color/call_control_background"
                    android:contentDescription="@string/call_mute"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:textColor="@android:color/transparent"
                    android:textSize="0sp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/call_icon_on_control" />

                <TextView
                    android:id="@+id/call_mute_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/call_mute"
                    android:textColor="@color/call_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Speaker Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/call_speaker"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_control_button"
                    app:backgroundTint="@color/call_control_background"
                    android:contentDescription="@string/call_speaker"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:textColor="@android:color/transparent"
                    android:textSize="0sp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_volume_up"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/call_icon_on_control" />

                <TextView
                    android:id="@+id/call_speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/call_speaker"
                    android:textColor="@color/call_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- End Call Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/call_hang_up"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:backgroundTint="@color/call_end_background"
                    android:contentDescription="@string/call_hang_up"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:textColor="@android:color/transparent"
                    android:textSize="0sp"
                    app:cornerRadius="36dp"
                    app:icon="@drawable/ic_call_end"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/call_icon_on_control" />

                <TextView
                    android:id="@+id/call_hang_up_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/call_hang_up"
                    android:textColor="@color/call_action_decline_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
