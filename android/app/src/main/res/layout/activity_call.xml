<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/call_peer_initials"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_call_avatar"
            android:gravity="center"
            android:textColor="@color/call_avatar_foreground"
            android:textSize="34sp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/call_peer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="30sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/call_mute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/call_mute"
                android:minHeight="56dp"
                android:text="@string/call_mute" />

            <Button
                android:id="@+id/call_speaker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/call_speaker"
                android:minHeight="56dp"
                android:text="@string/call_speaker" />
        </LinearLayout>

        <Button
            android:id="@+id/call_hang_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/call_end_background"
            android:contentDescription="@string/call_hang_up"
            android:minHeight="60dp"
            android:text="@string/call_hang_up"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
