<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forwardDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <include layout="@layout/include_sheet_handle" />

    <TextView
        android:id="@+id/forwardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/forward_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/forwardSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_md"
        android:hint="@string/forward_search_placeholder"
        app:boxBackgroundColor="?attr/colorSurfaceContainerLow"
        app:boxCornerRadiusBottomEnd="@dimen/corner_lg"
        app:boxCornerRadiusBottomStart="@dimen/corner_lg"
        app:boxCornerRadiusTopEnd="@dimen/corner_lg"
        app:boxCornerRadiusTopStart="@dimen/corner_lg"
        app:boxStrokeWidth="0dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/forwardSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/forwardEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:padding="@dimen/space_md"
        android:text="@string/forward_no_results"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/forwardList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/space_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/forwardSend"
        android:enabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/forward_send" />
</LinearLayout>
