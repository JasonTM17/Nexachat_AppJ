<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forwardDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/corner_xl"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/elevation_level1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="@dimen/space_xs"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="?attr/colorOutlineVariant"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/forwardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/forward_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/forwardSearchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:hint="@string/forward_search_placeholder"
            app:boxBackgroundColor="?attr/colorSurfaceContainer"
            app:boxCornerRadiusBottomEnd="@dimen/corner_xl"
            app:boxCornerRadiusBottomStart="@dimen/corner_xl"
            app:boxCornerRadiusTopEnd="@dimen/corner_xl"
            app:boxCornerRadiusTopStart="@dimen/corner_xl"
            app:boxStrokeWidth="0dp"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="?attr/colorOnSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/forwardSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/forwardEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_md"
            android:text="@string/forward_no_results"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/forwardList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/space_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forwardSend"
            android:enabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/forward_send"
            app:cornerRadius="@dimen/corner_md" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
