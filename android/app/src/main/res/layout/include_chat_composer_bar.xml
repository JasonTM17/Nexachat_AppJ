<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/composerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_composer"
    android:gravity="bottom"
    android:minHeight="@dimen/composer_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_xs"
    android:paddingVertical="@dimen/space_xs">

    <ImageButton
        android:id="@+id/attachButton"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_attach"
        android:padding="10dp"
        android:src="@drawable/ic_add"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/messageInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xs"
        android:layout_weight="1"
        android:background="@drawable/bg_composer_field"
        android:hint="@string/chat_input_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:imeOptions="actionNone"
        android:gravity="start|center_vertical"
        android:maxLines="6"
        android:minHeight="@dimen/min_touch_target"
        android:paddingHorizontal="@dimen/bubble_content_inset"
        android:paddingVertical="@dimen/space_sm"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/recordingOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xs"
        android:layout_weight="1"
        android:background="@drawable/bg_composer_pill"
        android:gravity="center_vertical"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/recordingDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/recordingDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/voice_recording_duration_zero"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError" />

        <TextView
            android:id="@+id/recordingCancelLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/voice_slide_to_cancel"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/composerActionSlot"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target">

        <com.nexachat.feature.chat.adapter.ChatActionImageButton
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/cd_send"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:visibility="gone"
            app:tint="@color/brand_on_fill" />

        <com.nexachat.feature.chat.adapter.ChatActionImageButton
            android:id="@+id/micButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_record_voice"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:visibility="visible"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>
</LinearLayout>
