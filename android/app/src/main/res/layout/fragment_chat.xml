<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/app_bar_min_height"
        android:background="?attr/colorSurface"
        app:subtitleTextAppearance="@style/TextAppearance.NexaChat.BodySmall"
        app:subtitleTextColor="?attr/colorOnSurfaceVariant"
        app:titleMarginStart="@dimen/chat_toolbar_title_start_with_avatar"
        app:titleTextAppearance="@style/TextAppearance.NexaChat.TitleMedium"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/chatToolbarActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <com.nexachat.core.ui.components.AvatarView
        android:id="@+id/chatHeaderAvatar"
        android:layout_width="@dimen/avatar_chat_size"
        android:layout_height="@dimen/avatar_chat_size"
        android:layout_marginStart="@dimen/min_touch_target"
        app:layout_constraintBottom_toBottomOf="@id/chatToolbar"
        app:layout_constraintStart_toStartOf="@id/chatToolbar"
        app:layout_constraintTop_toTopOf="@id/chatToolbar" />

    <HorizontalScrollView
        android:id="@+id/chatToolbarActions"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="@id/chatToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/chatToolbar">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/callButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/cd_call" android:src="@drawable/ic_call" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorPrimary"/>
            <ImageButton android:id="@+id/searchInChatButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/cd_search_in_chat" android:importantForAccessibility="no" android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" app:tint="?attr/colorOnSurface"/>
            <ImageButton android:id="@+id/infoButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/cd_group_info" android:importantForAccessibility="no" android:src="@drawable/ic_info" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" app:tint="?attr/colorOnSurface"/>
            <ImageButton android:id="@+id/summaryButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/summary_title" android:importantForAccessibility="no" android:src="@drawable/ic_auto_awesome" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" app:tint="?attr/colorPrimary"/>
            <ImageButton android:id="@+id/moreButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/a11y_open_chat_actions" android:src="@drawable/ic_more_vert" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorOnSurface"/>
        </LinearLayout>
    </HorizontalScrollView>

    <include
        android:id="@+id/pinnedBanner"
        layout="@layout/include_chat_pinned_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatToolbar" />

    <include
        android:id="@+id/replyEditBanner"
        layout="@layout/include_chat_reply_edit_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/composerBar" />

    <com.nexachat.feature.summary.UnreadBannerView
        android:id="@+id/unreadBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinnedBanner" />

    <LinearLayout
        android:id="@+id/chatSearchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_pill"
        android:gravity="center_vertical"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_sm"
        android:layout_margin="@dimen/space_sm"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unreadBanner">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/chatSearchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_in_chat_placeholder"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/closeChatSearch"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clear_search"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        app:layout_constraintBottom_toTopOf="@id/mentionPicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatSearchBar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mentionPicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elevation_level2"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/pendingAttachments"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scrollDownFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_md"
        android:contentDescription="@string/cd_scroll_to_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mentionPicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_keyboard_arrow_down" />

    <include
        android:id="@+id/composerBar"
        layout="@layout/include_chat_composer_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="@dimen/space_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/chatError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_inline_error"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/space_sm"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="?attr/colorOnErrorContainer"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        app:layout_constraintBottom_toTopOf="@id/replyEditBanner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/chatErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:textColor="?attr/colorOnErrorContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatErrorRetry"
            style="@style/Widget.NexaChat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/action_retry"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pendingAttachments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chatError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.nexachat.core.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/messageList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/messageList" />

    <com.nexachat.core.ui.components.LoadingStateView android:id="@+id/loadingState" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <com.nexachat.core.ui.components.ErrorStateView android:id="@+id/errorState" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
