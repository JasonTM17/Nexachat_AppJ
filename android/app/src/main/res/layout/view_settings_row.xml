<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_inset">

    <FrameLayout
        android:id="@+id/rowIconTile"
        android:layout_width="@dimen/icon_tile_size"
        android:layout_height="@dimen/icon_tile_size"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_settings_tile_tint">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/colorPrimary" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rowTextColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="@dimen/icon_size_sm"
        android:layout_height="@dimen/icon_size_sm"
        android:layout_marginStart="@dimen/space_xs"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_keyboard_arrow_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
