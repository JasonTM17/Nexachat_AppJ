<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_date_separator"
        android:backgroundTint="?attr/colorSurfaceVariant"
        android:maxWidth="@dimen/bubble_max_width"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/senderName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelSmall" android:visibility="gone"/>
        <include android:id="@+id/replyQuote" layout="@layout/include_message_reply_quote" android:visibility="gone"/>
        <TextView android:id="@+id/messageBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:visibility="gone"/>
        <ImageView android:id="@+id/messageImage" android:layout_width="220dp" android:layout_height="160dp" android:contentDescription="@string/cd_open_attachment" android:scaleType="centerCrop" android:visibility="gone"/>
        <ImageButton android:id="@+id/playButton" android:layout_width="@dimen/min_touch_target" android:layout_height="@dimen/min_touch_target" android:contentDescription="@string/cd_open_attachment" android:src="@drawable/ic_play_arrow" android:visibility="gone"/>
        <TextView android:id="@+id/fileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_description" android:gravity="center_vertical" android:visibility="gone"/>
        <TextView android:id="@+id/systemLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="visible"/>
        <include android:id="@+id/bubbleMeta" layout="@layout/include_message_bubble_meta"/>
        <include android:id="@+id/reactionsRow" layout="@layout/include_message_reactions_row"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
