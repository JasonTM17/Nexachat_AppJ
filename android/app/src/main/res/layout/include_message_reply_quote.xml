<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reply_quote"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">
    <TextView android:id="@+id/replyAuthor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelSmall" android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
    <TextView android:id="@+id/replySnippet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant"/>
</LinearLayout>
