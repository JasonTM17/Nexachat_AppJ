<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_message_reply_quote"
    android:minHeight="@dimen/min_touch_target">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_sm"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm">
        <TextView
            android:id="@+id/replyAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/replySnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</FrameLayout>
