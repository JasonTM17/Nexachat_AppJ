<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/list_item_padding_vertical">

        <com.nexachat.core.ui.components.AvatarView
            android:id="@+id/avatar"
            android:layout_width="@dimen/avatar_sm"
            android:layout_height="@dimen/avatar_sm" />

        <TextView
            android:id="@+id/memberName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_inset"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.chip.Chip
            android:id="@+id/memberRole"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:clickable="false"
            android:focusable="false"
            android:text="@string/group_role_admin"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:visibility="gone"
            android:checkable="false"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="?attr/colorSecondaryContainer"
            app:chipCornerRadius="@dimen/corner_sm"
            app:chipMinHeight="@dimen/chip_min_height"
            app:chipStrokeWidth="0dp"
            app:ensureMinTouchTargetSize="false" />

        <ImageButton
            android:id="@+id/removeMember"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_person_remove"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/divider_inset"
        android:background="?attr/colorSurfaceContainerHighest" />
</FrameLayout>
