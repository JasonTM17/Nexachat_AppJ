<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/auth_form_max_width"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Brand mark tile: Note monogram on the primary container. -->
                <ImageView
                    android:id="@+id/authLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_auth_logo"
                    android:contentDescription="@string/app_name"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_logo_mark" />

                <!-- App title -->
                <TextView
                    android:id="@+id/authTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/manrope"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textFontWeight="700"
                    tools:targetApi="p" />

                <LinearLayout
                    android:id="@+id/authModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="?attr/colorSurfaceContainerLow"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/authModeLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="2"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/action_sign_in"
                        android:textColor="@color/brand_on_fill"
                        app:backgroundTint="@color/brand_fill"
                        app:cornerRadius="@dimen/corner_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/authModeRegister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="2"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/action_create_account"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/corner_sm" />
                </LinearLayout>

                <include
                    android:id="@+id/googleEmailInUseError"
                    layout="@layout/include_google_email_in_use_error" />

                <TextView
                    android:id="@+id/errorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_auth_inline_error"
                    android:drawablePadding="@dimen/space_sm"
                    android:padding="@dimen/space_inset"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_error_outline"
                    app:drawableTint="?attr/colorError" />

                <TextView
                    android:id="@+id/noticeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_settings_tile_tint"
                    android:padding="@dimen/space_inset"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <!-- Sign in with Google (hidden when no web client ID was compiled in) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/googleSignIn"
                    style="@style/Widget.NexaChat.Button.Google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:contentDescription="@string/cd_continue_with_google"
                    android:minHeight="56dp"
                    android:text="@string/action_continue_with_google"
                    android:visibility="gone"
                    app:icon="@drawable/ic_google_g"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_inset"
                    app:iconTint="@null"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/authOrDivider"
                    layout="@layout/include_auth_or_divider" />

                <!-- Two input fields -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/auth_phone_label"
                    app:startIconDrawable="@drawable/ic_call">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="phone"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="phone"
                        android:nextFocusDown="@id/passwordInput" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/auth_password_label"
                    app:endIconContentDescription="@string/cd_password_visibility"
                    app:endIconDrawable="@drawable/ic_visibility"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:freezesText="false"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotPasswordAction"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="0dp"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/action_forgot_password" />

                <!-- One full-width primary button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:minHeight="56dp"
                    android:text="@string/action_sign_in"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/corner_md" />

                <!-- Text link -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondaryAction"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/action_create_account"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.nexachat.core.ui.components.LoadingStateView
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.nexachat.core.ui.components.ErrorStateView
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.nexachat.core.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
