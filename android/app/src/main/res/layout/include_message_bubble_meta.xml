<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubbleMetaRow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:layout_marginTop="@dimen/bubble_group_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/editedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/timeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ProgressBar
        android:id="@+id/sendingProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/metadata_icon_size"
        android:layout_height="@dimen/metadata_icon_size"
        android:layout_marginStart="@dimen/space_xs"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/deliveryIcon"
        android:layout_width="@dimen/metadata_icon_size"
        android:layout_height="@dimen/metadata_icon_size"
        android:layout_marginStart="@dimen/space_xs"
        android:contentDescription="@string/cd_delivered"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/deliveryStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
