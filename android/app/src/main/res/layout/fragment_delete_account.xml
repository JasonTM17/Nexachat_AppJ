<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/deleteAccountToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/delete_account_title" />

        <TextView
            android:id="@+id/deleteAccountConsequences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/delete_account_consequences"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/Widget.NexaChat.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/auth_current_password_label"
            app:endIconContentDescription="@string/cd_password_visibility"
            app:endIconDrawable="@drawable/ic_visibility"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendDeletionCode"
            style="@style/Widget.NexaChat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="56dp"
            android:text="@string/delete_account_send_code"
            android:visibility="gone"
            app:cornerRadius="@dimen/corner_md" />

        <TextView
            android:id="@+id/deletionCodeSentMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/delete_account_code_sent"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/deletionCodeLayout"
            style="@style/Widget.NexaChat.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/delete_account_code_label"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deletionCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_delete_account_code"
                android:imeOptions="actionDone"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/inlineError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_auth_inline_error"
            android:drawableStart="@drawable/ic_error_outline"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="?attr/colorError"
            android:padding="@dimen/space_inset"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileLoadRetry"
            style="@style/Widget.NexaChat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/action_retry"
            android:visibility="gone"
            app:cornerRadius="@dimen/corner_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmDelete"
            style="@style/Widget.NexaChat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="56dp"
            android:text="@string/delete_account_confirm"
            android:textColor="?attr/colorOnError"
            android:visibility="gone"
            app:backgroundTint="?attr/colorError"
            app:cornerRadius="@dimen/corner_md" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/deleteProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/voice_status_loading"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorError" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
