<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/archiveToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/archive_title"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/archiveTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:minHeight="@dimen/min_touch_target"
        app:tabMode="scrollable"
        app:tabGravity="center"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/archiveToolbar" />

    <HorizontalScrollView
        android:id="@+id/archiveFiltersScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/archiveTabs">

        <LinearLayout
            android:id="@+id/archiveFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/archiveSenderFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:minWidth="@dimen/min_touch_target"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/archive_filter_all_senders"
                app:icon="@drawable/ic_people"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/archiveDateFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:minHeight="@dimen/min_touch_target"
                android:minWidth="@dimen/min_touch_target"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/archive_filter_date" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/archiveClearFilters"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:minHeight="@dimen/min_touch_target"
                android:minWidth="@dimen/min_touch_target"
                android:maxLines="2"
                android:text="@string/archive_clear_filters"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/archiveContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/archiveFiltersScroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/archiveList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg"
            android:scrollbars="vertical" />

        <com.nexachat.core.ui.components.LoadingStateView
            android:id="@+id/archiveLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.nexachat.core.ui.components.EmptyStateView
            android:id="@+id/archiveEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.nexachat.core.ui.components.ErrorStateView
            android:id="@+id/archiveError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/archiveNextPageProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_md"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
