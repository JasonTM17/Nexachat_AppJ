<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_summary_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <FrameLayout
        android:id="@+id/summaryErrorIconTile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_settings_tile_tint">

        <ImageView
            android:id="@+id/summaryErrorIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_error_outline" />
    </FrameLayout>

    <TextView
        android:id="@+id/summaryErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/summaryErrorDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/summaryRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:minHeight="@dimen/min_touch_target"
        android:text="@string/summary_action_retry"
        android:visibility="gone"
        app:icon="@drawable/ic_refresh" />
</LinearLayout>
