<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:id="@+id/registerColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/auth_form_max_width"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Brand mark tile: Note monogram on the primary container. -->
                <ImageView
                    android:id="@+id/authLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_brand_logo"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_logo_mark"
                    app:tint="@color/nexa_logo_on_brand" />

                <!-- Form title -->
                <TextView
                    android:id="@+id/authTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/authModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_auth_mode_switch"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_xs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/authModeLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/action_sign_in"
                        android:textColor="@color/nexa_auth_mode_text"
                        app:backgroundTint="@color/nexa_auth_mode_bg"
                        app:rippleColor="@color/nexa_button_ripple"
                        app:toggleCheckedStateOnClick="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/authModeRegister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/action_create_account"
                        android:textColor="@color/nexa_auth_mode_text"
                        app:backgroundTint="@color/nexa_auth_mode_bg"
                        app:rippleColor="@color/nexa_button_ripple"
                        app:toggleCheckedStateOnClick="false" />
                </LinearLayout>

                <include
                    android:id="@+id/googleEmailInUseError"
                    layout="@layout/include_google_email_in_use_error" />

                <TextView
                    android:id="@+id/errorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_auth_inline_error"
                    android:drawablePadding="@dimen/space_sm"
                    android:padding="@dimen/space_inset"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_error_outline"
                    app:drawableTint="?attr/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/googleSignIn"
                    style="@style/Widget.NexaChat.Button.Google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:contentDescription="@string/cd_continue_with_google"
                    android:text="@string/action_continue_with_google"
                    android:visibility="gone"
                    app:icon="@drawable/ic_google_g"
                    app:iconGravity="textStart"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/authOrDivider"
                    layout="@layout/include_auth_or_divider" />

                <LinearLayout
                    android:id="@+id/formFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_display_name_label"
                    app:startIconDrawable="@drawable/ic_person_outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPersonName|textCapWords"
                        android:nextFocusDown="@id/emailInput" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/auth_email_label"
                    app:placeholderText="@string/auth_email_placeholder"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress"
                        android:nextFocusDown="@id/passwordInput" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/auth_password_label"
                    app:endIconContentDescription="@string/cd_password_visibility"
                    app:endIconDrawable="@drawable/ic_visibility"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/auth_password_policy_hint"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:freezesText="false"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:nextFocusDown="@id/confirmPasswordInput"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    style="@style/Widget.NexaChat.TextInputLayout.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/auth_confirm_password_label"
                    app:endIconContentDescription="@string/cd_password_visibility"
                    app:endIconDrawable="@drawable/ic_visibility"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:freezesText="false"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Second step: the code mailed to the address -->
                <LinearLayout
                    android:id="@+id/codeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/codeSentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/codeLayout"
                        style="@style/Widget.NexaChat.TextInputLayout.Auth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/recovery_email_otp_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/codeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_signup_code"
                            android:freezesText="false"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- One full-width primary button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/signup_send_code"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconTint="?attr/colorOnPrimary" />

                <LinearLayout
                    android:id="@+id/codeActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resendCodeButton"
                        style="@style/Widget.NexaChat.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/recovery_email_resend" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeEmailButton"
                        style="@style/Widget.NexaChat.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/signup_change_email" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.nexachat.core.ui.components.LoadingStateView
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <com.nexachat.core.ui.components.ErrorStateView
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.nexachat.core.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
