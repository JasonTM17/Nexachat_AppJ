<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/recoveryFormToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/recoveryFormEmailLayout"
            style="@style/Widget.NexaChat.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/recovery_email_field_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recoveryFormEmailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:contentDescription="@string/cd_recovery_email_input"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/recoveryFormError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_auth_inline_error"
            android:drawableStart="@drawable/ic_error_outline"
            android:drawableTint="?attr/colorError"
            android:drawablePadding="@dimen/space_sm"
            android:padding="@dimen/space_inset"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recoveryFormSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/recovery_email_send_code" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.nexachat.core.ui.components.LoadingStateView
        android:id="@+id/recoveryFormLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
