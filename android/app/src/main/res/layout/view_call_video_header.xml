<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_video_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_call_video_header"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/call_video_header_end_inset"
    android:paddingBottom="@dimen/call_video_header_fade"
    android:visibility="gone">

    <TextView
        android:id="@+id/call_video_peer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.NexaChat.TitleMedium"
        android:textColor="@color/call_text_primary"
        android:textDirection="firstStrong" />

    <TextView
        android:id="@+id/call_video_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="none"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.NexaChat.BodySmall"
        android:textColor="@color/call_video_header_detail" />
</LinearLayout>
