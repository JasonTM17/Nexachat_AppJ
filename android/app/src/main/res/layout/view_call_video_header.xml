<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_video_header"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_call_video_header"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_sm"
    android:visibility="gone">

    <TextView
        android:id="@+id/call_video_peer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/call_text_primary"
        android:textDirection="firstStrong"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_video_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:accessibilityLiveRegion="none"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/call_text_secondary" />
</LinearLayout>
