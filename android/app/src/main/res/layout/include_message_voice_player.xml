<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voicePlayerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="216dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/voicePlayButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/voice_play"
        android:padding="12dp"
        android:src="@drawable/ic_play_arrow" />

    <com.nexachat.feature.chat.voice.WaveformView
        android:id="@+id/voiceWaveform"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:contentDescription="@string/voice_play"
        android:minWidth="96dp" />

    <TextView
        android:id="@+id/voiceDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:minWidth="40dp"
        android:text="@string/voice_zero_duration"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_open_attachment"
        android:src="@drawable/ic_play_arrow"
        android:visibility="gone" />
</LinearLayout>
