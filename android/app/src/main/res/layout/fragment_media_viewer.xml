<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexa_media_meta_surface">

    <FrameLayout
        android:id="@+id/mediaContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.nexachat.feature.media.ZoomableMediaImageView
            android:id="@+id/mediaImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_media_photo_zoom"
            android:visibility="gone" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/mediaPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <FrameLayout
            android:id="@+id/mediaLoadingHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/mediaErrorHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/viewerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/nexa_on_media_meta"
        app:titleTextAppearance="?attr/textAppearanceTitleMedium"
        app:titleTextColor="@color/nexa_on_media_meta" />
</FrameLayout>
