<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/googleEmailInUseError"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/bg_settings_tile_error"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/googleEmailInUseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/error_google_email_in_use_title"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnErrorContainer"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/googleEmailInUseBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/error_google_email_in_use_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnErrorContainer" />
</LinearLayout>
