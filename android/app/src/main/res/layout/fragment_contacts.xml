<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/cd_back">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchButton"
                style="@style/Widget.NexaChat.Button.Icon"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/search_title"
                app:icon="@drawable/ic_search" />
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/contactsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_sm"
            app:layout_scrollFlags="enterAlways|scroll">

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:background="@drawable/bg_search_pill"
                android:clickable="true"
                android:clipToOutline="true"
                android:contentDescription="@string/inbox_search_hint"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/min_touch_target"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_inset"
                    android:layout_weight="1"
                    android:text="@string/inbox_search_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.nexachat.core.ui.components.SettingsRowView
                android:id="@+id/addContactEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_grouped_list_band"
                android:clipToOutline="true"
                android:foreground="?attr/selectableItemBackground" />

            <com.nexachat.core.ui.components.SettingsRowView
                android:id="@+id/createGroupEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_grouped_list_band"
                android:clipToOutline="true"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contactList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/space_md"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.nexachat.feature.contacts.ContactLetterRailView
        android:id="@+id/letterRail"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_sm"
        android:visibility="gone"
        app:layout_behavior="com.nexachat.feature.contacts.ContactLetterRailBehavior" />

    <TextView
        android:id="@+id/letterBubble"
        android:layout_width="@dimen/letter_bubble_size"
        android:layout_height="@dimen/letter_bubble_size"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/letter_bubble_margin_end"
        android:background="@drawable/bg_letter_bubble"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minHeight="@dimen/letter_bubble_size"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone" />

    <com.nexachat.core.ui.components.LoadingStateView
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.nexachat.core.ui.components.ErrorStateView
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.nexachat.core.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
