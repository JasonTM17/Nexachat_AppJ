<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="@dimen/space_lg">

      <LinearLayout
        android:id="@+id/completeProfileColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/auth_form_max_width"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/authLogo"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center_horizontal"
          android:background="@drawable/bg_auth_logo"
          android:contentDescription="@string/app_name"
          android:padding="14dp"
          android:scaleType="centerInside"
          android:src="@drawable/ic_logo_mark" />

        <TextView
          android:id="@+id/completeProfileTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_md"
          android:layout_marginBottom="@dimen/space_lg"
          android:accessibilityHeading="true"
          android:fontFamily="@font/manrope"
          android:text="@string/complete_profile_title"
          android:textAppearance="?attr/textAppearanceHeadlineMedium"
          android:textColor="?attr/colorOnSurface"
          android:textFontWeight="700"
          tools:targetApi="p" />

        <com.nexachat.core.ui.components.AvatarView
          android:id="@+id/completeProfileAvatar"
          android:layout_width="96dp"
          android:layout_height="96dp"
          android:contentDescription="@string/cd_complete_profile_avatar" />

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/displayNameLayout"
          style="@style/Widget.NexaChat.TextInputLayout.Auth"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_lg"
          android:hint="@string/complete_profile_display_name_label"
          app:startIconDrawable="@drawable/ic_person_outline">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/displayNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_md"
          app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
          app:cardCornerRadius="@dimen/corner_md"
          app:cardElevation="0dp"
          app:strokeColor="?attr/colorOutlineVariant"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_inset">

            <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:contentDescription="@null"
              android:importantForAccessibility="no"
              android:src="@drawable/ic_email"
              app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
              android:id="@+id/completeProfileEmail"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/space_inset"
              android:layout_weight="1"
              android:ellipsize="end"
              android:maxLines="1"
              android:textAppearance="?attr/textAppearanceBodyLarge"
              android:textColor="?attr/colorOnSurface"
              tools:text="user@gmail.com" />

            <ImageView
              android:id="@+id/completeProfileEmailVerified"
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_marginStart="@dimen/space_sm"
              android:contentDescription="@string/cd_complete_profile_email_verified"
              android:src="@drawable/ic_check_circle"
              app:tint="?attr/colorPrimary" />

            <com.google.android.material.chip.Chip
              android:id="@+id/completeProfileGoogleChip"
              style="@style/Widget.Material3.Chip.Assist"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/space_sm"
              android:clickable="false"
              android:focusable="false"
              android:text="@string/complete_profile_google_chip"
              app:chipIcon="@drawable/ic_google_g"
              app:chipIconTint="@null"
              app:chipIconVisible="true" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
          android:id="@+id/completeProfileError"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_md"
          android:accessibilityLiveRegion="polite"
          android:background="@drawable/bg_auth_inline_error"
          android:drawablePadding="@dimen/space_sm"
          android:drawableStart="@drawable/ic_error_outline"
          android:drawableTint="?attr/colorError"
          android:padding="@dimen/space_inset"
          android:textAppearance="?attr/textAppearanceBodyMedium"
          android:textColor="?attr/colorOnErrorContainer"
          android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/completeProfileContinue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_lg"
          android:minHeight="56dp"
          android:text="@string/action_continue"
          android:textStyle="bold"
          app:cornerRadius="@dimen/corner_md" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>

  <com.nexachat.core.ui.components.LoadingStateView
    android:id="@+id/loadingState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone" />
</FrameLayout>
