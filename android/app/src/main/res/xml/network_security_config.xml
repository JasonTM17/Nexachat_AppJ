<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network security configuration.
  Cleartext HTTP/WS traffic is strictly disabled globally with no exemptions.
  All production connections must use TLS (HTTPS/WSS).
  Cleartext overrides for the emulator and LAN development live in the debug
  and localSmoke source sets. Android applies base-config, not domain-config,
  to IP literals, so those variants cannot list 10.0.2.2 as a domain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
