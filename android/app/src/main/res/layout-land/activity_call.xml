<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    android:fitsSystemWindows="true">

    <!-- Full-screen remote video (voice calls keep it hidden) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/call_remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/call_avatar_wrap"
                android:layout_width="168dp"
                android:layout_height="168dp">

                <View
                    android:id="@+id/call_pulse_ring"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:alpha="0.35"
                    android:background="@drawable/bg_call_pulse_ring"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/call_peer_initials"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/call_avatar_foreground"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/call_peer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/call_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/call_text_secondary" />

            <TextView
                android:id="@+id/call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/call_text_primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/view_call_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_call_video_header" />

    <!-- Floating local camera preview (top-end, video calls only) -->
    <FrameLayout
        android:id="@+id/call_local_preview"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_call_local_preview"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/call_local_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
