<?xml version="1.0" encoding="utf-8"?>
<!--
    NexaChat Detailed Adaptive Icon Foreground (108x108 grid, strictly inside 66x66 safe zone: 21..87).
    Visual hierarchy:
    1. Multi-layer soft ambient drop shadows for depth.
    2. Secondary incoming chat/voice bubble (top-right, Electric Cyan gradient #38BDF8 -> #0284C7)
       with subtle inner highlight and three Equalizer / Voice Call bars.
    3. Primary outgoing chat squircle bubble (center-left, pearlescent glass gradient)
       with a smooth conversational tail, specular rim bevel, and inner shadow.
    4. Sculpted 3D Nexus 'N' monogram inside the primary bubble (Indigo-Violet gradients)
       bridged by a folded diagonal ribbon.
    5. Golden-Cyan 4-point AI Summary Spark at the nexus intersection + micro star accents.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ==================== 1. AMBIENT DROP SHADOWS ==================== -->
    <!-- Outer soft shadow under primary + secondary bubbles -->
    <path
        android:fillColor="#38050816"
        android:pathData="M34,33 h30 a12,12 0 0,1 12,12 v18 a12,12 0 0,1 -12,12 h-17 l-9.5,7.2 c-1.6,1.2 -3.7,-0.2 -3.3,-2.2 l1.3,-5.0 a12,12 0 0,1 -10.5,-12 v-18 a12,12 0 0,1 9,-12 z" />
    <path
        android:fillColor="#2E050816"
        android:pathData="M54,25 h19 a9.5,9.5 0 0,1 9.5,9.5 v11.5 a9.5,9.5 0 0,1 -4.2,7.9 l1.1,4.3 c0.3,1.2 -1.0,2.1 -2.0,1.4 l-5.2,-3.6 h-18.2 a9.5,9.5 0 0,1 -9.5,-9.5 v-12 a9.5,9.5 0 0,1 9.5,-9.5 z" />

    <!-- ==================== 2. SECONDARY VOICE / INCOMING BUBBLE (TOP-RIGHT) ==================== -->
    <!-- Cyan bubble body with vibrant sky-to-ocean gradient -->
    <path android:pathData="M53.5,23.5 h19 a9.5,9.5 0 0,1 9.5,9.5 v11 a9.5,9.5 0 0,1 -4.0,7.7 l1.2,4.4 c0.32,1.15 -0.92,2.05 -1.92,1.38 l-5.38,-3.48 h-18.4 a9.5,9.5 0 0,1 -9.5,-9.5 v-11.5 a9.5,9.5 0 0,1 9.5,-9.5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="23.5"
                android:endX="82"
                android:endY="56"
                android:type="linear">
                <item android:color="#67E8F9" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.45" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular rim stroke on secondary bubble -->
    <path
        android:fillColor="#00000000"
        android:pathData="M53.5,23.5 h19 a9.5,9.5 0 0,1 9.5,9.5 v11 a9.5,9.5 0 0,1 -4.0,7.7 l1.2,4.4 c0.32,1.15 -0.92,2.05 -1.92,1.38 l-5.38,-3.48 h-18.4 a9.5,9.5 0 0,1 -9.5,-9.5 v-11.5 a9.5,9.5 0 0,1 9.5,-9.5 z"
        android:strokeWidth="0.9"
        android:strokeColor="#80FFFFFF" />

    <!-- Voice Call / Audio Equalizer Bars inside top-right bubble -->
    <path
        android:fillColor="#F0F9FF"
        android:pathData="M61.5,31.2 a1.4,1.4 0 0,1 2.8,0 v6.6 a1.4,1.4 0 0,1 -2.8,0 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M66.6,28.5 a1.4,1.4 0 0,1 2.8,0 v12.0 a1.4,1.4 0 0,1 -2.8,0 z" />
    <path
        android:fillColor="#F0F9FF"
        android:pathData="M71.7,32.5 a1.4,1.4 0 0,1 2.8,0 v5.2 a1.4,1.4 0 0,1 -2.8,0 z" />

    <!-- ==================== 3. PRIMARY CHAT BUBBLE (FOREGROUND LEFT-CENTER) ==================== -->
    <!-- Soft contact shadow cast by primary bubble onto secondary bubble -->
    <path
        android:fillColor="#30090D24"
        android:pathData="M36.5,31.5 h27.5 a12.5,12.5 0 0,1 12.5,12.5 v17.5 a12.5,12.5 0 0,1 -12.5,12.5 h-16.2 l-9.6,7.0 c-1.55,1.12 -3.62,-0.25 -3.18,-2.12 l1.28,-5.28 a12.5,12.5 0 0,1 -9.8,-12.1 v-17.5 a12.5,12.5 0 0,1 10.0,-12.5 z" />

    <!-- Primary Squircle Chat Bubble Body (Pearlescent White-to-Ice-Indigo Gradient) -->
    <path android:pathData="M36,30.5 h27.5 a12.5,12.5 0 0,1 12.5,12.5 v17.5 a12.5,12.5 0 0,1 -12.5,12.5 h-16.2 l-9.6,7.0 c-1.55,1.12 -3.62,-0.25 -3.18,-2.12 l1.28,-5.28 a12.5,12.5 0 0,1 -9.8,-12.1 v-17.5 a12.5,12.5 0 0,1 10.0,-12.5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="30.5"
                android:endX="74"
                android:endY="76"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#F8FAFC" android:offset="0.58" />
                <item android:color="#E0E7FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Primary Bubble Top-Left Glossy Bevel Rim -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,30.5 h27.5 a12.5,12.5 0 0,1 12.5,12.5 v17.5 a12.5,12.5 0 0,1 -12.5,12.5 h-16.2 l-9.6,7.0 c-1.55,1.12 -3.62,-0.25 -3.18,-2.12 l1.28,-5.28 a12.5,12.5 0 0,1 -9.8,-12.1 v-17.5 a12.5,12.5 0 0,1 10.0,-12.5 z"
        android:strokeWidth="1.15"
        android:strokeColor="#FFFFFF" />

    <!-- Subtle inner recessed border for tactile badge feel -->
    <path
        android:fillColor="#00000000"
        android:pathData="M37,33.2 h25.5 a9.8,9.8 0 0,1 9.8,9.8 v15.2 a9.8,9.8 0 0,1 -9.8,9.8 h-25.5 a9.8,9.8 0 0,1 -9.8,-9.8 v-15.2 a9.8,9.8 0 0,1 9.8,-9.8 z"
        android:strokeWidth="0.55"
        android:strokeColor="#284F46E5" />

    <!-- ==================== 4. 3D SCULPTED NEXUS 'N' MONOGRAM ==================== -->
    <!-- Left Vertical Pillar of 'N' (Deep Royal Indigo Gradient) -->
    <path android:pathData="M35.5,41.2 c0,-2.1 1.7,-3.8 3.8,-3.8 c2.1,0 3.8,1.7 3.8,3.8 v20.6 c0,2.1 -1.7,3.8 -3.8,3.8 c-2.1,0 -3.8,-1.7 -3.8,-3.8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35.5"
                android:startY="37.4"
                android:endX="43.1"
                android:endY="65.6"
                android:type="linear">
                <item android:color="#4338CA" android:offset="0.0" />
                <item android:color="#312E81" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Vertical Pillar of 'N' (Vibrant Indigo-to-Cyan Gradient) -->
    <path android:pathData="M56.4,41.2 c0,-2.1 1.7,-3.8 3.8,-3.8 c2.1,0 3.8,1.7 3.8,3.8 v20.6 c0,2.1 -1.7,3.8 -3.8,3.8 c-2.1,0 -3.8,-1.7 -3.8,-3.8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="56.4"
                android:startY="37.4"
                android:endX="64.0"
                android:endY="65.6"
                android:type="linear">
                <item android:color="#0284C7" android:offset="0.0" />
                <item android:color="#4F46E5" android:offset="0.65" />
                <item android:color="#3730A3" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagonal Folded Ribbon of 'N' (Electric Violet-Indigo-Sky Bridge) -->
    <path android:pathData="M36.8,38.4 c1.6,-1.2 3.9,-0.8 5.2,0.8 l20.8,22.4 c1.4,1.5 1.2,3.8 -0.4,5.0 c-1.6,1.2 -3.9,0.8 -5.2,-0.8 l-20.8,-22.4 c-1.4,-1.5 -1.2,-3.8 0.4,-5.0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="38"
                android:endX="63"
                android:endY="66"
                android:type="linear">
                <item android:color="#6366F1" android:offset="0.0" />
                <item android:color="#4F46E5" android:offset="0.5" />
                <item android:color="#0EA5E9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ==================== 5. CENTRAL AI SUMMARY SPARK & HIGHLIGHTS ==================== -->
    <!-- Outer halo behind central AI spark -->
    <path
        android:fillColor="#4038BDF8"
        android:pathData="M49.8,51.5 m-6.2,0 a6.2,6.2 0 1,0 12.4,0 a6.2,6.2 0 1,0 -12.4,0" />

    <!-- 4-Point AI Catch-Up Summary Spark at the center of the 'N' bridge -->
    <path android:pathData="M49.8,44.2 C50.3,48.8 51.0,49.5 55.6,50.0 C51.0,50.5 50.3,51.2 49.8,55.8 C49.3,51.2 48.6,50.5 44.0,50.0 C48.6,49.5 49.3,48.8 49.8,44.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44.0"
                android:startY="44.2"
                android:endX="55.6"
                android:endY="55.8"
                android:type="linear">
                <item android:color="#FEF08A" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="0.45" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Micro sparkle dot (top-left of primary bubble interior) -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M49.8,37.8 C50.0,39.2 50.3,39.5 51.7,39.7 C50.3,39.9 50.0,40.2 49.8,41.6 C49.6,40.2 49.3,39.9 47.9,39.7 C49.3,39.5 49.6,39.2 49.8,37.8 Z" />
</vector>
