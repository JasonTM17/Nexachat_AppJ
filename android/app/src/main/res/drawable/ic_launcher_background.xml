<?xml version="1.0" encoding="utf-8"?>
<!--
    NexaChat Rich Multi-Layered Adaptive Icon Background (108x108 dp).
    Features:
    1. Deep midnight-indigo diagonal base gradient (#1E1B4B -> #312E81 -> #0F172A).
    2. Top-left electric indigo ambient spotlight (#6366F1 radial glow).
    3. Bottom-right cyan aurora glow (#06B6D4 radial glow) for real-time energy.
    4. Subtle precision geometric signal rings and grid accents within the canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Base Diagonal Rich Indigo-to-Midnight Gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="6"
                android:endX="100"
                android:endY="102"
                android:type="linear">
                <item android:color="#3730A3" android:offset="0.0" />
                <item android:color="#1E1B4B" android:offset="0.52" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Top-Left Electric Indigo Radial Spotlight -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="20"
                android:gradientRadius="68"
                android:type="radial">
                <item android:color="#736366F1" android:offset="0.0" />
                <item android:color="#334F46E5" android:offset="0.55" />
                <item android:color="#00312E81" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Bottom-Right Cyber Cyan Aurora Glow -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="88"
                android:centerY="88"
                android:gradientRadius="60"
                android:type="radial">
                <item android:color="#5906B6D4" android:offset="0.0" />
                <item android:color="#240284C7" android:offset="0.55" />
                <item android:color="#000F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Subtle Concentric Acoustic / Signal Rings -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0"
        android:strokeWidth="0.6"
        android:strokeColor="#1FFFFFFF" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54m-33,0a33,33 0,1 1,66 0a33,33 0,1 1,-66 0"
        android:strokeWidth="0.75"
        android:strokeColor="#2638BDF8" />

    <!-- 5. Soft Diagonal Light Sheen -->
    <path android:pathData="M0,0 L108,0 L64,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="10"
                android:endX="68"
                android:endY="78"
                android:type="linear">
                <item android:color="#1CFFFFFF" android:offset="0.0" />
                <item android:color="#08FFFFFF" android:offset="0.5" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
