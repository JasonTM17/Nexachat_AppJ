<?xml version="1.0" encoding="utf-8"?>
<!-- The accent bar sits inside the quote so it stays visible on outgoing (primary) bubbles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/colorPrimaryContainer" />
      <corners android:radius="@dimen/corner_sm" />
    </shape>
  </item>
  <item
      android:width="3dp"
      android:gravity="start|fill_vertical"
      android:top="@dimen/space_xs"
      android:bottom="@dimen/space_xs"
      android:start="@dimen/space_xs">
    <shape android:shape="rectangle">
      <solid android:color="?attr/colorPrimary" />
      <corners android:radius="2dp" />
    </shape>
  </item>
</layer-list>