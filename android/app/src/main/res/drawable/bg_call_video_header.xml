<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">

    <!-- Keep contrast behind the text even when the name wraps at larger font sizes. -->
    <item android:bottom="@dimen/call_video_header_fade">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/call_video_header_shade_top"
                android:endColor="@color/call_video_header_shade_bottom" />
        </shape>
    </item>

    <item
        android:gravity="bottom|fill_horizontal"
        android:height="@dimen/call_video_header_fade">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/call_video_header_shade_bottom"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
