<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.nexachat.feature.splash.SplashFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nexachat.feature.auth.LoginFragment"
        android:label="@string/action_sign_in" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nexachat.feature.auth.RegisterFragment"
        android:label="@string/action_create_account" />

    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.nexachat.feature.inbox.InboxFragment"
        android:label="@string/inbox_title" />

    <fragment
        android:id="@+id/contactsFragment"
        android:name="com.nexachat.feature.contacts.ContactsFragment"
        android:label="@string/contacts_title" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.nexachat.feature.contacts.UserSearchFragment"
        android:label="@string/search_title" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.nexachat.feature.profile.ProfileFragment"
        android:label="@string/profile_title" />

    <fragment
        android:id="@+id/languageSettingsFragment"
        android:name="com.nexachat.feature.profile.LanguageSettingsFragment"
        android:label="@string/settings_language" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.nexachat.feature.chat.ChatFragment"
        android:label="@string/chat_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
        <argument
            android:name="archiveJumpMessageId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/archiveFragment"
        android:name="com.nexachat.feature.archive.ArchiveFragment"
        android:label="@string/archive_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/groupCreateFragment"
        android:name="com.nexachat.feature.group.CreateGroupFragment"
        android:label="@string/group_create_title" />

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.nexachat.feature.group.GroupDetailFragment"
        android:label="@string/group_detail_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/inviteManageFragment"
        android:name="com.nexachat.feature.invite.InviteManageFragment"
        android:label="@string/invite_manage_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/inviteJoinFragment"
        android:name="com.nexachat.feature.invite.InviteJoinFragment"
        android:label="@string/invite_join_title">
        <argument
            android:name="token"
            app:argType="string" />
        <deepLink app:uri="nexachat://join/{token}" />
        <!-- Gradle supplies an empty URI unless a verified HTTPS host is configured. -->
        <deepLink app:uri="@string/invite_https_deep_link_pattern" />
    </fragment>

    <fragment
        android:id="@+id/mediaViewerFragment"
        android:name="com.nexachat.feature.media.MediaViewerFragment"
        android:label="@string/media_attachment">
        <argument
            android:name="attachmentId"
            app:argType="string" />
        <argument
            android:name="name"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="mime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />

</navigation>
