<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$SplashHostFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$LoginHostFragment"
        android:label="@string/action_sign_in" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$RegisterHostFragment"
        android:label="@string/action_create_account" />

    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$InboxHostFragment"
        android:label="@string/inbox_title" />

    <fragment
        android:id="@+id/contactsFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$ContactsHostFragment"
        android:label="@string/contacts_title" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$SearchHostFragment"
        android:label="@string/search_title" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$ProfileHostFragment"
        android:label="@string/profile_title" />

    <fragment
        android:id="@+id/languageSettingsFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$LanguageSettingsHostFragment"
        android:label="@string/settings_language" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$ChatHostFragment"
        android:label="@string/chat_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/groupCreateFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$GroupCreateHostFragment"
        android:label="@string/group_create_title" />

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$GroupDetailHostFragment"
        android:label="@string/group_detail_title">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/mediaViewerFragment"
        android:name="com.nexachat.core.ui.host.HostFragments$MediaViewerHostFragment"
        android:label="@string/media_attachment">
        <argument
            android:name="attachmentId"
            app:argType="string" />
        <argument
            android:name="name"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="mime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />

</navigation>
