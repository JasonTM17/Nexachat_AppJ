<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-source-set override. localSmoke carries its own copy under
  src/localSmoke/res/xml/network_security_config.xml because that build type
  does not merge src/debug. Cleartext is permitted from the base-config:
  the emulator and LAN dev servers are IP literals, and Android does not
  apply domain-config to IP addresses. Release uses src/main, where
  cleartext is disabled with no exemptions.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
