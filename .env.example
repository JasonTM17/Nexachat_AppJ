DATABASE_URL=jdbc:postgresql://db:5432/nexachat
DATABASE_USER=nexachat
DATABASE_PASSWORD=replace-with-a-local-only-password
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
# Optional: Base64 of 32 cryptographically random bytes; keep one stable value across all server instances.
NEXACHAT_REFRESH_REPLAY_KEY=
# Storage provider: local (default) or s3.
# Deployed topology uses Supabase Storage (S3 protocol, region ap-southeast-1,
# private bucket, path-style; endpoint https://<project-ref>.storage.supabase.co/storage/v1/s3).
# Cloudflare R2 is a supported alternative (region auto, endpoint https://<account-id>.r2.cloudflarestorage.com).
NEXACHAT_STORAGE_PROVIDER=local
NEXACHAT_STORAGE_S3_ENDPOINT=
NEXACHAT_STORAGE_S3_REGION=ap-southeast-1
NEXACHAT_STORAGE_S3_BUCKET=
NEXACHAT_STORAGE_S3_ACCESS_KEY_ID=
NEXACHAT_STORAGE_S3_SECRET_ACCESS_KEY=
# Object-store deadlines. The attempt deadline must not exceed the call deadline.
NEXACHAT_STORAGE_S3_API_CALL_TIMEOUT=60s
NEXACHAT_STORAGE_S3_API_CALL_ATTEMPT_TIMEOUT=30s
NEXACHAT_STORAGE_S3_CONNECTION_TIMEOUT=5s
NEXACHAT_STORAGE_S3_SOCKET_TIMEOUT=30s
STORAGE_ROOT=/app/data/uploads
# Multipart scratch directory. Empty keeps the servlet-container temp directory
# (/tmp in the image). A configured path is created at boot and must be writable.
NEXACHAT_MULTIPART_TEMP_DIR=

# Server security hardening.
# NEXACHAT_CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call
# the API. Leave empty unless a web client exists; the Android app sends no
# Origin header and is unaffected either way.
NEXACHAT_CORS_ALLOWED_ORIGINS=

# Choose smtp, resend, or blank to disable OTP email delivery.
NEXACHAT_MAIL_PROVIDER=
# SMTP relay hostname. Gmail is the default starting provider.
MAIL_SMTP_HOST=smtp.gmail.com
# SMTP port; 587 is used with STARTTLS required.
MAIL_SMTP_PORT=587
# SMTP account name; store credentials only in the ignored .env or secret store.
MAIL_SMTP_USERNAME=
# Gmail app password or SMTP password; store only in the ignored .env or secret store.
MAIL_SMTP_PASSWORD=
# Sender address configured for the SMTP provider.
MAIL_FROM=
# Resend API key; store only in the deployment secret store and rotate it there.
RESEND_API_KEY=
# Resend sender address on a verified domain.
RESEND_FROM=
# NEXACHAT_ADMIN_PHONES: comma-separated E.164 numbers allowed to read operator
# telemetry (/api/v1/rag/stats). Empty denies the endpoint to everyone.
NEXACHAT_ADMIN_PHONES=
# NEXACHAT_MAX_JSON_BODY_BYTES: JSON request bodies above this size are rejected
# with 413. Multipart uploads keep their own 25 MB ceiling.
NEXACHAT_MAX_JSON_BODY_BYTES=1048576
# NEXACHAT_VALIDITY_CACHE_TTL_SECONDS: how long the JWT filter caches a user's
# access-token cutoff. Capped at the access-token lifetime (900 s).
NEXACHAT_VALIDITY_CACHE_TTL_SECONDS=60
# NEXACHAT_TRUSTED_PROXY_CIDRS: comma-separated CIDRs/exact IPs of reverse
# proxies that may set X-Forwarded-For for client-IP rate limits. Empty keeps
# the socket peer (safe default behind no proxy).
NEXACHAT_TRUSTED_PROXY_CIDRS=
# NEXACHAT_CLIENT_IP_HEADER: header read for the client IP when the peer is a
# trusted proxy. Empty = X-Forwarded-For, read right to left. Render uses
# CF-Connecting-IP.
NEXACHAT_CLIENT_IP_HEADER=

# Firebase Cloud Messaging (FCM) push notifications.
# FCM_SERVICE_ACCOUNT_JSON accepts the service-account JSON inline or a path to a key file.
# The key's project must match FCM_PROJECT_ID; Application Default Credentials do not work.
# Leave FCM_ENABLED=false unless a valid Google service account is configured.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Optional ephemeral realtime bridge (presence/typing only); disabled by default.
# Reuses FCM_PROJECT_ID and FCM_SERVICE_ACCOUNT_JSON when explicitly enabled.
# The service account must be a private-key JSON (inline or a readable file);
# Application Default Credentials alone do not work.
FIREBASE_REALTIME_ENABLED=false
FIREBASE_REALTIME_DEFAULT=stomp
FIREBASE_CALL_STATUS_ENABLED=false
FIREBASE_DATABASE_URL=
FIREBASE_CONNECT_TIMEOUT_SECONDS=5
FIREBASE_READ_TIMEOUT_SECONDS=10
# Host path for the optional read-only key mount in docker-compose.firebase.yml.
# This is a Compose interpolation input, not a server setting.
NEXACHAT_FIREBASE_KEY_HOST_FILE=

# Cloud LLM Tier for conversation summaries (OpenAI-compatible endpoint; Gemini tested)
# Example base URL: https://generativelanguage.googleapis.com/v1beta/openai/
# Example model: gemini-3.1-flash-lite
NEXACHAT_SUMMARY_LLM_ENABLED=false
NEXACHAT_SUMMARY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NEXACHAT_SUMMARY_LLM_MODEL=gemini-3.1-flash-lite
NEXACHAT_SUMMARY_LLM_API_KEY=

# Fallback cloud LLM tier (tried once when the primary fails retryably).
# Disabled by default; set the key to activate it.
NEXACHAT_SUMMARY_LLM_FALLBACK_ENABLED=false
NEXACHAT_SUMMARY_LLM_FALLBACK_BASE_URL=https://api.deepseek.com
NEXACHAT_SUMMARY_LLM_FALLBACK_MODEL=deepseek-flash
NEXACHAT_SUMMARY_LLM_FALLBACK_API_KEY=
NEXACHAT_SUMMARY_LLM_FALLBACK_TIMEOUT_MS=30000

# Local Server Model Tier (Ollama / vLLM / local server container for routine AI summaries)
NEXACHAT_SUMMARY_LOCAL_LLM_ENABLED=false
NEXACHAT_SUMMARY_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
NEXACHAT_SUMMARY_LOCAL_LLM_MODEL=qwen2.5:3b
NEXACHAT_SUMMARY_LOCAL_LLM_API_KEY=local-ollama
NEXACHAT_SUMMARY_LOCAL_LLM_TIMEOUT_MS=60000

# Complexity gate thresholds (routine windows stay on local engine/model; complex escalate to external LLM)
NEXACHAT_SUMMARY_COMPLEXITY_MIN_MESSAGES=12
NEXACHAT_SUMMARY_COMPLEXITY_MIN_CHARS=1500
NEXACHAT_SUMMARY_COMPLEXITY_MIN_PARTICIPANTS=4

# Conversation RAG ("Ask this chat"). Defaults work fully offline with the
# deterministic lexical embedding provider and need no API key.
NEXACHAT_RAG_ENABLED=true
NEXACHAT_RAG_EMBEDDING_PROVIDER=lexical   # lexical | openai-compatible
NEXACHAT_RAG_EMBEDDING_MODE=openai-compatible   # openai-compatible | gemini
NEXACHAT_RAG_EMBEDDING_BASE_URL=
NEXACHAT_RAG_EMBEDDING_MODEL=gemini-embedding-001
NEXACHAT_RAG_EMBEDDING_API_KEY=           # defaults to NEXACHAT_SUMMARY_LLM_API_KEY
NEXACHAT_RAG_EMBEDDING_DIM=256
NEXACHAT_RAG_EMBEDDING_TIMEOUT_MS=20000
NEXACHAT_RAG_MAX_CONTEXT_CHARS=3000
NEXACHAT_RAG_NOT_FOUND_THRESHOLD=0.18
NEXACHAT_RAG_EXTRACTIVE_THRESHOLD=0.62
NEXACHAT_RAG_SEMANTIC_CACHE_THRESHOLD=0.92
NEXACHAT_RAG_INDEX_LAZY_LIMIT=500
NEXACHAT_RAG_BACKFILL_RATE_PER_MINUTE=200
NEXACHAT_RAG_ASK_RATE_LIMIT_PER_MINUTE=20
NEXACHAT_RAG_ASK_RATE_LIMIT_PER_DAY=200

# Orphaned-avatar sweep (disabled by default, dry-run). Enables the bounded
# avatars/ cleanup for files no user or group avatar URL references.
NEXACHAT_AVATAR_SWEEP_ENABLED=false
NEXACHAT_AVATAR_SWEEP_DRY_RUN=true
NEXACHAT_AVATAR_SWEEP_BATCH_SIZE=100
NEXACHAT_AVATAR_SWEEP_MIN_AGE_HOURS=24
NEXACHAT_AVATAR_SWEEP_INTERVAL_MS=86400000

# Bounded retention cleanup jobs (disabled by default). Compose forwards these
# to the app container; see docs/operations/operations.md for the full matrix.
NEXACHAT_RETENTION_ENABLED=false
NEXACHAT_RETENTION_DRY_RUN=true
NEXACHAT_RETENTION_BATCH_SIZE=100
NEXACHAT_RETENTION_STATEMENT_TIMEOUT_MS=2000
NEXACHAT_RETENTION_TRANSACTION_TIMEOUT_SECONDS=15
NEXACHAT_RETENTION_INTERVAL_MS=3600000
NEXACHAT_RETENTION_JOIN_REQUESTS_ENABLED=false
NEXACHAT_RETENTION_JOIN_REQUESTS_RETENTION_DAYS=30
NEXACHAT_RETENTION_INVITE_BANS_ENABLED=false
NEXACHAT_RETENTION_INVITE_LINKS_ENABLED=false
NEXACHAT_RETENTION_INVITE_LINKS_GRACE_DAYS=30
NEXACHAT_RETENTION_IDEMPOTENCY_ENABLED=false
NEXACHAT_RETENTION_IDEMPOTENCY_TTL_HOURS=24
NEXACHAT_RETENTION_REFRESH_TOKENS_ENABLED=false
NEXACHAT_RETENTION_REFRESH_TOKENS_RETENTION_DAYS=30
NEXACHAT_RETENTION_DEVICE_TOKENS_ENABLED=false
NEXACHAT_RETENTION_DEVICE_TOKENS_STALE_DAYS=180
NEXACHAT_RETENTION_REMINDERS_ENABLED=false
NEXACHAT_RETENTION_REMINDERS_RETENTION_DAYS=30
NEXACHAT_RETENTION_POLLS_ENABLED=false
NEXACHAT_RETENTION_POLLS_RETENTION_DAYS=365
NEXACHAT_RETENTION_CALL_RECORDS_ENABLED=false
NEXACHAT_RETENTION_CALL_RECORDS_RETENTION_DAYS=365
NEXACHAT_RETENTION_ATTACHMENTS_ENABLED=false
NEXACHAT_RETENTION_ATTACHMENTS_UNBOUND_HOURS=24
NEXACHAT_RETENTION_ATTACHMENTS_DELETED_MESSAGE_DAYS=30
NEXACHAT_RETENTION_MESSAGE_TOMBSTONES_ENABLED=false
NEXACHAT_RETENTION_MESSAGE_TOMBSTONES_RETENTION_DAYS=30
NEXACHAT_RETENTION_REACTION_EVENTS_ENABLED=false
NEXACHAT_RETENTION_SUMMARIES_ENABLED=false
NEXACHAT_RETENTION_SUMMARY_LIMITS_ENABLED=false
NEXACHAT_RETENTION_SUMMARY_LIMITS_MINUTE_DAYS=1
NEXACHAT_RETENTION_SUMMARY_LIMITS_DAY_DAYS=2
NEXACHAT_RETENTION_RAG_CACHE_ENABLED=false
NEXACHAT_RETENTION_RAG_LIMITS_ENABLED=false
NEXACHAT_RETENTION_RAG_LIMITS_MINUTE_DAYS=1
NEXACHAT_RETENTION_RAG_LIMITS_DAY_DAYS=2

# "Sign in with Google" (OpenID Connect). Disabled by default; when enabled the
# web client ID and at least one trusted Android OAuth client ID are required
# when enabled; startup fails closed without either. Android reads the web client
# ID from -PgoogleWebClientId= (empty hides the Google buttons).
NEXACHAT_GOOGLE_SIGNIN_ENABLED=false
# Google account creation from an unknown Google sub (needs sign-in enabled).
NEXACHAT_GOOGLE_SIGNUP_ENABLED=false
NEXACHAT_GOOGLE_WEB_CLIENT_ID=
# Comma-separated Android OAuth client IDs trusted as the ID token azp; required
# when Google sign-in is enabled.
NEXACHAT_GOOGLE_ANDROID_CLIENT_IDS=
# Comma-separated exact accepted ID-token iss claims; defaults preserve Google's two issuer spellings.
NEXACHAT_GOOGLE_SIGNIN_ISSUER=accounts.google.com,https://accounts.google.com
# Google's public key set; override only for tests with a local JWKS.
NEXACHAT_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
NEXACHAT_GOOGLE_NONCE_TTL_SECONDS=300
