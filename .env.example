DATABASE_URL=jdbc:postgresql://db:5432/nexachat
DATABASE_USER=nexachat
DATABASE_PASSWORD=replace-with-a-local-only-password
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
STORAGE_ROOT=/app/data/uploads

# Firebase Cloud Messaging (FCM) push notifications.
# FCM_SERVICE_ACCOUNT_JSON accepts the service-account JSON inline or a path to a key file.
# Leave FCM_ENABLED=false unless a valid Google service account is configured.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Cloud LLM Tier for conversation summaries (DeepSeek Cloud for complex/difficult summaries)
NEXACHAT_SUMMARY_LLM_ENABLED=false
NEXACHAT_SUMMARY_LLM_BASE_URL=https://api.deepseek.com
NEXACHAT_SUMMARY_LLM_MODEL=deepseek-flash
NEXACHAT_SUMMARY_LLM_API_KEY=

# Local Server Model Tier (Ollama / vLLM / local server container for routine AI summaries)
NEXACHAT_SUMMARY_LOCAL_LLM_ENABLED=false
NEXACHAT_SUMMARY_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
NEXACHAT_SUMMARY_LOCAL_LLM_MODEL=qwen2.5:3b
NEXACHAT_SUMMARY_LOCAL_LLM_API_KEY=local-ollama
NEXACHAT_SUMMARY_LOCAL_LLM_TIMEOUT_MS=60000

# Complexity gate thresholds (routine windows stay on local engine/model; complex escalate to DeepSeek)
NEXACHAT_SUMMARY_COMPLEXITY_MIN_MESSAGES=12
NEXACHAT_SUMMARY_COMPLEXITY_MIN_CHARS=1500
NEXACHAT_SUMMARY_COMPLEXITY_MIN_PARTICIPANTS=4
