<?xml version="1.0" encoding="UTF-8"?>
<!--
  NexaChat logging configuration.

  Default profile: Spring Boot's console pattern.
  json-logs profile: one JSON object per line with the correlation id, through
  RedactingJsonLayout (bearer tokens, JWTs, phones, FCM tokens, API keys and
  message/content fields are masked before the event is written).

  Enable with SPRING_PROFILES_ACTIVE=prod,json-logs (or add json-logs to the
  active profiles). Secrets are never written to the console in either profile.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="rootLevel" source="logging.level.root" defaultValue="INFO"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.nexachat.observability.RedactingJsonLayout"/>
        </encoder>
    </appender>

    <springProfile name="json-logs">
        <property name="consoleAppender" value="JSON_CONSOLE"/>
    </springProfile>
    <springProfile name="!json-logs">
        <property name="consoleAppender" value="CONSOLE"/>
    </springProfile>

    <root level="${rootLevel}">
        <appender-ref ref="${consoleAppender}"/>
    </root>
</configuration>
