# ---- Build outputs ----
build/
**/build/
target/
*.class
*.jar
*.war
*.apk
*.aab
*.dex
*.o
*.so

# ---- Dependencies ----
node_modules/
.gradle/
.cxx/
.kotlin/
__pycache__/
*.py[cod]
# gradle-wrapper.jar must be committed despite the *.jar rule above —
# it is required for reproducible wrapper bootstrap on fresh checkouts.
!**/gradle-wrapper.jar

# ---- Signing / Secrets (NEVER commit) ----
*.keystore
*.jks
*.p12
*.pkcs12
*.bks
keystore.properties
.env
.env.*
!.env.example
google-services.json
secrets.properties
**/local.properties

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Runtime / data ----
# Root-anchored: a bare `data/` would also ignore source packages like
# android/app/src/main/java/com/nexachat/data/ (repository implementations).
/data/
logs/
*.log
server/uploads/
demo/backups/

# ---- Release artifacts (local signing & builds — never committed) ----
# Signing keystore, signing.properties, and built APKs live here.
# See tools/README-release.md.
release/

# ---- Agent / workspace internals ----
.agentkit/
.agents/
.claude/
.codex/
.devin/
plans/

# ---- Local tooling / profiling leftovers ----
.vercel/
server/data/
signing.properties
captures/
tools/fcm-live-check/.out/
*.hprof
.tmp_*
desktop.ini

# ---- Local-only capture evidence ----
docs/evidence/
